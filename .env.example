# Copie este ficheiro para .env e preencha os valores.
PORT=3000
NODE_ENV=development
APP_NAME=Salemo Resolve Tudo
JWT_SECRET=MUDE_PARA_UMA_CHAVE_LONGA_E_ALEATORIA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Conta de administrador criada automaticamente se ainda não existir.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=MUDE_ESTA_SENHA_FORTE

# Pagamentos manuais: preencha com os seus dados comerciais reais.
PAYMENT_METHODS=M-Pesa,e-Mola,Transferência bancária
PAYMENT_NUMBER=
PAYMENT_HOLDER=
PAYMENT_INSTRUCTIONS=Faça o pagamento e envie a referência nesta plataforma. O administrador irá confirmar manualmente.
